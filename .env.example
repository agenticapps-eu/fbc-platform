# Copy to .env.local and fill via Infisical — never commit real values.
# In dev/CI, prefer: infisical run -- pnpm dev   (injects secrets at runtime)

# --- Supabase (DB / Auth / RLS) — added in a later phase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Sentry (error monitoring) ---
VITE_SENTRY_DSN=

# --- Axiom (logs/analytics — server-side, later) ---
AXIOM_TOKEN=
AXIOM_DATASET=

# --- Infisical (secrets manager) ---
INFISICAL_PROJECT_ID=
