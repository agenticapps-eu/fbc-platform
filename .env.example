# Placeholder reference of all secret keys — NEVER commit real values.
# Secrets are managed in Infisical; `pnpm dev` injects them at runtime via
# `infisical run`. This file documents the keys; see docs/secrets.md for where
# each one lives and how to set it.

# =============================================================================
# CLIENT-EXPOSED (Vite inlines every VITE_* var into the browser bundle).
# These also belong in Cloudflare Pages build-env later. NEVER put a secret
# that must stay private behind a VITE_ prefix.
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=
# VITE_SENTRY_RELEASE is NOT stored in Infisical — it is injected from the Git
# SHA at prod-build time (see the `build:prod` script). Listed here for docs only.

# =============================================================================
# SERVER-ONLY — never prefix with VITE_, never ship to the client. Lives only
# in Pages Functions / Supabase / CI runtime.
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY=
AXIOM_TOKEN=
AXIOM_DATASET=
# AXIOM_URL — optional override of the ingest edge base. NOT needed: the
# /api/log function defaults to the EU edge (eu-central-1.aws.edge.axiom.co).
# See docs/observability.md.
AXIOM_URL=
SENTRY_AUTH_TOKEN=
# SENTRY_ORG / SENTRY_PROJECT — non-secret build config for source-map upload.
# Default to "factiv" / "fbc-platform" in vite.config.ts if unset.
SENTRY_ORG=
SENTRY_PROJECT=
CLOUDFLARE_API_TOKEN=
# RESEND_API_KEY=   # transactional email — added in a later phase

# =============================================================================
# Infisical (secrets manager) — project reference, not a secret.
# The active project ref is committed in .infisical.json; this var only matters
# if you override it (e.g. INFISICAL_PROJECT_ID for a one-off command).
# =============================================================================
INFISICAL_PROJECT_ID=
