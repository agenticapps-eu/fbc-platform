<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Die Startfläche (AGE-713).

         Hier stand `android:background="@drawable/splash"` — der Weg VOR der
         SplashScreen-API. Seit Android 12 zeichnet das System die Fläche aus
         `windowSplashScreenBackground` und `windowSplashScreenAnimatedIcon`;
         das Bitmap unter `@drawable/splash` wird nicht mehr gezeigt. Das Thema
         erbte also schon von `Theme.SplashScreen`, fütterte es aber mit einem
         Attribut, das es nicht liest.

         `androidx.core:core-splashscreen` bildet dieselben zwei Attribute auf
         API 24-30 nach. Die Umstellung wirkt deshalb auf ALLEN unterstützten
         Fassungen, nicht erst ab 12.

         `postSplashScreenTheme` fehlte ganz. Ohne es bleibt die Activity nach
         der Startfläche auf dem Start-Thema stehen, statt auf das der App zu
         wechseln. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashHintergrund</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>