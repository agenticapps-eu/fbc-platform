<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          AGE-642: der Mitteilungskanal, in dem Push landet.

          Ohne diese Zeile legt FCM sich selbst einen an. Gemessen am 04.09.
          mit `dumpsys notification`, nachdem die Zustellung durch war:
          `channel=fcm_fallback_notification_channel`, `sound=null
          vibrate=null defaults=0`; im logcat dazu `Missing Default
          Notification Channel metadata in AndroidManifest`. In den
          Systemeinstellungen heisst dieser Kanal „Sonstiges".

          Der Wert MUSS zeichengleich mit `PUSH_KANAL_ID` in `src/lib/push.ts`
          sein — `push.kanal.test.ts` haelt beide zusammen. Diese Datei nennt
          nur die Kennung; angelegt wird der Kanal beim Start ueber
          `pushKanalAnlegen()`, denn ein Kanal, den es zum Zustellzeitpunkt
          nicht gibt, faellt wieder auf den Fallback zurueck.

          Diese Datei ist NICHT von `cap sync` erzeugt und darf angefasst
          werden — die Kamera-Rechte unten stehen ebenso von Hand darin.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mitteilungen" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      AGE-642: Kamera. Das Gegenstueck zu NSCameraUsageDescription auf iOS.

      Die Laufzeit-Abfrage muss dieser Code NICHT selbst fuehren: Capacitors
      BridgeWebChromeClient.onShowFileChooser ruft `permissionLauncher.launch`
      und bricht den Datei-Dialog sauber ab, wenn abgelehnt wird
      (BridgeWebChromeClient.java:285-300).

      Gemessen am 28.08.: dieser Zweig greift nur bei `isCaptureEnabled()` UND
      genau `image/*` in `accept`. Die sechs Upload-Felder dieser App fuehren
      beides nicht — sie tragen eine Typenliste und kein `capture` — und landen
      damit heute alle im System-Dateiwaehler. Die Deklaration aendert also
      vorerst nichts am Verhalten; sie steht hier, damit die Huelle beim Anlegen
      vollstaendig ist und C3 (Kamera) sie nicht nachtragen muss.

      `required="false"`, sonst filtert Play Geraete ohne Kamera aus der
      Auslieferung heraus — die Berechtigung allein macht das Feature sonst zur
      Voraussetzung.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
