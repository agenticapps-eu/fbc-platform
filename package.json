{
  "name": "fbc-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "infisical run --env=dev -- vite",
    "build": "tsc --noEmit && vite build",
    "build:prod": "tsc --noEmit && infisical run --env=prod -- sh -c 'VITE_SENTRY_RELEASE=$(git rev-parse HEAD) vite build'",
    "preview": "vite preview",
    "db:push": "infisical run --env=dev -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL_DEV\"'",
    "db:push:prod": "infisical run --env=prod -- tsx scripts/push-prod.ts db",
    "config:push:prod": "infisical run --env=prod -- tsx scripts/push-prod.ts config",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "typecheck:seed": "tsc --noEmit -p supabase/seed/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:seed": "infisical run --env=dev -- tsx supabase/seed/demo_seed.ts",
    "demo:reset": "infisical run --env=dev -- env DEMO_SEED_MODE=reset tsx supabase/seed/demo_seed.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@sentry/react": "^10.57.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "framer-motion": "^12.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260612.1",
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "4.119.0"
  }
}
