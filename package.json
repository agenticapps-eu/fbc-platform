{
  "name": "fbc-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "infisical run --env=dev -- vite",
    "release:entries": "tsx scripts/generate-release-entries.ts",
    "prebuild": "tsx scripts/generate-release-entries.ts",
    "build": "tsc --noEmit && vite build",
    "build:prod": "tsc --noEmit && infisical run --env=prod -- sh -c 'VITE_SENTRY_RELEASE=$(git rev-parse HEAD) vite build'",
    "preview": "vite preview",
    "db:push": "infisical run --env=dev -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL_DEV\"'",
    "db:push:prod": "infisical run --env=prod -- tsx scripts/push-prod.ts db",
    "sync:dev": "infisical run --env=prod -- tsx scripts/sync-dev-ruecklauf.ts --ziel=dev",
    "config:push:prod": "infisical run --env=prod -- tsx scripts/push-prod.ts config",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "typecheck:seed": "tsc --noEmit -p supabase/seed/tsconfig.json",
    "test": "vitest run",
    "test:integration": "FBC_INTEGRATION=1 vitest run",
    "test:watch": "vitest",
    "demo:seed": "infisical run --env=dev -- tsx supabase/seed/demo_seed.ts",
    "demo:reset": "infisical run --env=dev -- env DEMO_SEED_MODE=reset tsx supabase/seed/demo_seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react": "^10.71.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.2",
    "framer-motion": "^12.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "csv-parse": "^7.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "4.120.0"
  }
}
