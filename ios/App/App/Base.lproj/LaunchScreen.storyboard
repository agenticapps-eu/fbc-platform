<?xml version="1.0" encoding="UTF-8"?>
<!--
  Die Startfläche (AGE-642, B5).

  DREI EBENEN, ALLE AM VERHÄLTNIS AUFGEHÄNGT. Feste Punkte wären hier der
  Fehler: die App erlaubt Hoch- UND Querformat und ist universell gebaut
  (TARGETED_DEVICE_FAMILY = "1,2"). Alle Multiplier stehen als benannte
  Konstanten in scripts/splash.logic.ts und sind dort geprüft:

    BAND_ANTEIL                  0.62   Höhe des Fotos
    SCHRIFTZUG_OBEN              0.58   Oberkante des Schriftzugs
    SCHRIFTZUG_HOEHE             0.25   Höhe des Schriftzugs
    SCHRIFTZUG_SEITENVERHAELTNIS 1.2    Breite/Höhe des Schriftzugs

  Daraus folgt die Invariante, die den Text von jeder Bildlage trennt:
  SCHRIFTZUG_OBEN >= BAND_ANTEIL * 0.78 — der Schriftzug beginnt erst, wo die
  Rampe deckend weiss ist. Beide Seiten sind Anteile DERSELBEN Höhe, also gilt
  sie für jedes Gerät und jede Orientierung zugleich.

  DER VERLAUF IST EINE EIGENE, GESTRECKTE EBENE und nicht ins Foto gebacken.
  Ein eingebackener Verlauf würde beim formatfüllenden Beschneiden mit
  beschnitten — quer läge seine Unterkante mitten im Farbverlauf, und die Kante
  des Fotos wäre sichtbar.

  DIE FLÄCHE IST AUSDRÜCKLICH WEISS und nicht systemBackgroundColor: die wird
  im Dunkelmodus schwarz. Unter dem alten deckenden PNG fiel das nicht auf, hier
  wäre es die Fläche unter dunkler Schrift. Ein dunkles Inhaltsthema hat diese
  App nicht.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="17132" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17105"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="rootView">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="Splash" translatesAutoresizingMaskIntoConstraints="NO" id="fotoView">
                                <rect key="frame" x="0.0" y="0.0" width="375" height="414"/>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="SplashVerlauf" translatesAutoresizingMaskIntoConstraints="NO" id="verlaufView">
                                <rect key="frame" x="0.0" y="0.0" width="375" height="414"/>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="SplashSchriftzug" translatesAutoresizingMaskIntoConstraints="NO" id="zugView">
                                <rect key="frame" x="32" y="387" width="200" height="167"/>
                                <constraints>
                                    <constraint firstAttribute="width" secondItem="zugView" secondAttribute="height" multiplier="1.2" id="zug-seitenverhaeltnis"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safeArea"/>
                        <color key="backgroundColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="fotoView" firstAttribute="top" secondItem="rootView" secondAttribute="top" id="foto-oben"/>
                            <constraint firstItem="fotoView" firstAttribute="leading" secondItem="rootView" secondAttribute="leading" id="foto-links"/>
                            <constraint firstAttribute="trailing" secondItem="fotoView" secondAttribute="trailing" id="foto-rechts"/>
                            <constraint firstItem="fotoView" firstAttribute="height" secondItem="rootView" secondAttribute="height" multiplier="0.62" id="foto-hoehe"/>
                            <constraint firstItem="verlaufView" firstAttribute="top" secondItem="fotoView" secondAttribute="top" id="verlauf-oben"/>
                            <constraint firstItem="verlaufView" firstAttribute="leading" secondItem="fotoView" secondAttribute="leading" id="verlauf-links"/>
                            <constraint firstItem="verlaufView" firstAttribute="trailing" secondItem="fotoView" secondAttribute="trailing" id="verlauf-rechts"/>
                            <constraint firstItem="verlaufView" firstAttribute="bottom" secondItem="fotoView" secondAttribute="bottom" id="verlauf-unten"/>
                            <constraint firstItem="zugView" firstAttribute="leading" secondItem="rootView" secondAttribute="leading" constant="32" id="zug-links"/>
                            <constraint firstItem="zugView" firstAttribute="top" secondItem="rootView" secondAttribute="bottom" multiplier="0.58" id="zug-oben"/>
                            <constraint firstItem="zugView" firstAttribute="height" secondItem="rootView" secondAttribute="height" multiplier="0.25" id="zug-hoehe"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="Splash" width="1290" height="1734"/>
        <image name="SplashSchriftzug" width="1200" height="1000"/>
        <image name="SplashVerlauf" width="8" height="1024"/>
    </resources>
</document>
